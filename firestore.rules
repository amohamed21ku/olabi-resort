rules_version = '2';

// Olabi Resort — Firestore security rules.
// Public site needs to read listings and create bookings/applications;
// everything administrative requires an authenticated admin user.
service cloud.firestore {
  match /databases/{database}/documents {

    // Room inventory + customer-facing listings — public read, admin write.
    match /rooms/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /variants/{id} { allow read: if true; allow write: if request.auth != null; }

    // Bookings — the public booking flow reads availability and creates a
    // booking; only admins may change or delete one.
    match /bookings/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Editable site content (e.g. the hiking event page) — public read, admin write.
    match /siteContent/{id} { allow read: if true; allow write: if request.auth != null; }

    // Hiking event applications — visitors may submit; only admins may read/manage.
    match /hikeApplications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
