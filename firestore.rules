rules_version = '2';

// Olabi Resort — Firestore security rules.
// Public site needs to read listings and create bookings/applications;
// everything administrative requires an admin account (see isAdmin).
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin accounts, by Firebase Auth UID. Anyone can create a Firebase Auth
    // account with the site's public API key, so being signed in is NOT proof
    // of being staff. To add a staff account: create it in Firebase console →
    // Authentication, add its UID here, and redeploy the rules.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'gDjd3dGhrrSuHALsfXu6YFq1pSL2', // admin@olabiresort.com
      ];
    }

    // Room inventory + customer-facing listings — public read, admin write.
    match /rooms/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /variants/{id} { allow read: if true; allow write: if isAdmin(); }

    // Bookings — public read, because the booking page computes availability
    // from every booking's room-lines. So guest personal details never go
    // here; they live in bookingGuests/{id} below. Only admins may change or
    // delete a booking.
    match /bookings/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Guest personal details for bookings/{id} (name, phone, email, region,
    // ID number, notes) — admins only. A visitor may create one only in the
    // same write that creates its booking, so nobody can attach details to,
    // or overwrite them on, someone else's booking.
    match /bookingGuests/{id} {
      allow create: if isAdmin() || (
        existsAfter(/databases/$(database)/documents/bookings/$(id))
        && !exists(/databases/$(database)/documents/bookings/$(id))
      );
      allow read, update, delete: if isAdmin();
    }

    // Editable site content (e.g. the hiking event page) — public read, admin write.
    match /siteContent/{id} { allow read: if true; allow write: if isAdmin(); }

    // Hiking event applications — visitors may submit; only admins may read/manage.
    match /hikeApplications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
